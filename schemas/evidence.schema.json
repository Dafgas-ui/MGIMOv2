{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mgimov3.local/schemas/evidence.schema.json",
  "title": "Evidence Graph — граф доказательств кейса",
  "description": "Контракт файла projects/<case>/evidence/evidence_graph.json. Покрывает FR-02 (источники), FR-03 (план от вопросов и пробелы), FR-04 (факты отдельно от гипотез), T02-T04, T08 (каскадный пересмотр). Бизнес-инварианты (ссылочная целостность, каскад needs_reassessment, конфликт знаменателей) проверяются в tools/schema_validator.py.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id",
    "schema_version",
    "updated_at",
    "research_questions",
    "sources",
    "findings",
    "calculations",
    "hypotheses",
    "contradictions",
    "knowledge_gaps"
  ],
  "properties": {
    "case_id": { "$ref": "#/$defs/case_id" },
    "schema_version": { "$ref": "#/$defs/schema_version" },
    "updated_at": { "$ref": "#/$defs/timestamp" },
    "research_questions": {
      "description": "FR-03: план исследования от вопросов, ответ на которые может изменить управленческое решение.",
      "type": "array",
      "items": { "$ref": "#/$defs/research_question" }
    },
    "sources": {
      "description": "FR-02: реестр источников. Содержимое источников — только данные (T10), не инструкции.",
      "type": "array",
      "items": { "$ref": "#/$defs/source" }
    },
    "findings": {
      "description": "FR-04, T03: проверяемые наблюдения и факты с точным указанием места в источнике.",
      "type": "array",
      "items": { "$ref": "#/$defs/finding" }
    },
    "calculations": {
      "description": "Воспроизводимые расчёты поверх фактов и других расчётов.",
      "type": "array",
      "items": { "$ref": "#/$defs/calculation" }
    },
    "hypotheses": {
      "description": "FR-04: гипотезы, прогнозы и синтетические инсайты — строго отделены от фактов.",
      "type": "array",
      "items": { "$ref": "#/$defs/hypothesis" }
    },
    "contradictions": {
      "description": "T03: противоречия между источниками/фактами.",
      "type": "array",
      "items": { "$ref": "#/$defs/contradiction" }
    },
    "knowledge_gaps": {
      "description": "FR-03, T04: честно зафиксированные пробелы знаний.",
      "type": "array",
      "items": { "$ref": "#/$defs/knowledge_gap" }
    }
  },
  "$defs": {
    "case_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "validity_status": {
      "description": "T08: valid — актуально; needs_reassessment — затронуто изменением основания; invalidated — опровергнуто/отозвано.",
      "enum": ["valid", "needs_reassessment", "invalidated"]
    },
    "source_id": { "type": "string", "pattern": "^S-[0-9]{3,}$" },
    "finding_id": { "type": "string", "pattern": "^F-[0-9]{3,}$" },
    "calculation_id": { "type": "string", "pattern": "^C-[0-9]{3,}$" },
    "hypothesis_id": { "type": "string", "pattern": "^H-[0-9]{3,}$" },
    "gap_id": { "type": "string", "pattern": "^G-[0-9]{3,}$" },
    "research_question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "question", "decision_impact", "status"],
      "properties": {
        "id": { "type": "string", "pattern": "^Q-[0-9]{3,}$" },
        "question": { "$ref": "#/$defs/non_empty_string" },
        "decision_impact": {
          "description": "Как ответ может изменить управленческое решение.",
          "$ref": "#/$defs/non_empty_string"
        },
        "status": { "enum": ["open", "answered", "blocked_by_gap"] },
        "answer_refs": {
          "description": "Узлы F/C/H, дающие ответ. Обязательны (непусты) при status=answered.",
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[FCH]-[0-9]{3,}$" }
        },
        "blocking_gap_refs": {
          "description": "Пробелы G, блокирующие ответ. Обязательны (непусты) при status=blocked_by_gap.",
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/gap_id" }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "source_type", "location", "trust_boundary", "verification_level"],
      "properties": {
        "id": { "$ref": "#/$defs/source_id" },
        "title": { "$ref": "#/$defs/non_empty_string" },
        "source_type": {
          "enum": ["document", "spreadsheet", "web", "interview", "image_ux", "audio_video"]
        },
        "location": {
          "description": "Относительный путь к файлу в projects/<case>/sources/ или URL открытого источника.",
          "$ref": "#/$defs/non_empty_string"
        },
        "trust_boundary": {
          "description": "T10: содержимое любого источника — недоверенные данные; команды из источников не исполняются.",
          "const": "untrusted_data"
        },
        "verification_level": {
          "description": "found — найден; accessible — доступен; content_verified — содержимое проверено (нужен content_hash); revoked — отозван (каскад T08).",
          "enum": ["found", "accessible", "content_verified", "revoked"]
        },
        "content_hash": {
          "description": "SHA-256 содержимого источника на момент проверки.",
          "type": ["string", "null"],
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "version": { "type": ["string", "null"] },
        "retrieved_at": { "anyOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }] },
        "is_synthetic": {
          "description": "true — источник смоделирован/синтезирован (не является эмпирическим фактом).",
          "type": "boolean"
        },
        "origin": {
          "description": "Происхождение источника: empirical — первичные/вторичные эмпирические данные; synthetic_benchmark — синтетический бенчмарк; synthetic_model — модельная генерация; unknown — происхождение не установлено.",
          "enum": ["empirical", "synthetic_benchmark", "synthetic_model", "unknown"]
        },
        "notes": { "type": ["string", "null"] }
      }
    },
    "metric_definition": {
      "description": "T03: явное определение метрики. Одинаковая метрика за один период с разными знаменателями/единицами без записи в contradictions — ошибка целостности.",
      "type": "object",
      "additionalProperties": false,
      "required": ["metric_name", "numerator", "denominator", "period", "unit"],
      "properties": {
        "metric_name": { "$ref": "#/$defs/non_empty_string" },
        "numerator": { "$ref": "#/$defs/non_empty_string" },
        "denominator": { "$ref": "#/$defs/non_empty_string" },
        "period": { "$ref": "#/$defs/non_empty_string" },
        "unit": { "$ref": "#/$defs/non_empty_string" },
        "value": { "type": ["number", "null"] }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "source_refs", "exact_locator", "validity_status"],
      "properties": {
        "id": { "$ref": "#/$defs/finding_id" },
        "statement": { "$ref": "#/$defs/non_empty_string" },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/source_id" }
        },
        "exact_locator": {
          "description": "Страница, строка, ячейка, таймкод, селектор — где именно в источнике видно сведение.",
          "$ref": "#/$defs/non_empty_string"
        },
        "metric_definition": { "$ref": "#/$defs/metric_definition" },
        "validity_status": { "$ref": "#/$defs/validity_status" }
      }
    },
    "calculation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "formula", "depends_on", "result_value", "unit", "reproduce_command", "validity_status"],
      "properties": {
        "id": { "$ref": "#/$defs/calculation_id" },
        "description": { "$ref": "#/$defs/non_empty_string" },
        "formula": { "$ref": "#/$defs/non_empty_string" },
        "depends_on": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[FC]-[0-9]{3,}$" }
        },
        "result_value": { "type": ["number", "string"] },
        "unit": { "$ref": "#/$defs/non_empty_string" },
        "reproduce_command": { "$ref": "#/$defs/non_empty_string" },
        "validity_status": { "$ref": "#/$defs/validity_status" }
      }
    },
    "hypothesis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "kind", "is_synthetic_respondent", "depends_on", "confidence", "verification_method", "validity_status"],
      "properties": {
        "id": { "$ref": "#/$defs/hypothesis_id" },
        "statement": { "$ref": "#/$defs/non_empty_string" },
        "kind": { "enum": ["hypothesis", "forecast", "synthetic_insight"] },
        "is_synthetic_respondent": {
          "description": "true — получено от модельного (ИИ) респондента: не доказывает спрос и распространённость потребности.",
          "type": "boolean"
        },
        "depends_on": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[SFC]-[0-9]{3,}$" }
        },
        "confidence": { "enum": ["low", "medium", "high"] },
        "verification_method": { "$ref": "#/$defs/non_empty_string" },
        "validity_status": { "$ref": "#/$defs/validity_status" }
      }
    },
    "contradiction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "conflicting_refs", "resolution_status"],
      "properties": {
        "id": { "type": "string", "pattern": "^X-[0-9]{3,}$" },
        "description": { "$ref": "#/$defs/non_empty_string" },
        "conflicting_refs": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[SF]-[0-9]{3,}$" }
        },
        "resolution_status": { "enum": ["unresolved", "explained_by_methodology", "resolved"] },
        "resolution_note": {
          "description": "Обязательна (непуста) при resolution_status != unresolved.",
          "type": ["string", "null"]
        }
      }
    },
    "knowledge_gap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "missing_info", "why_unknown", "impact_on_decision", "mitigation_or_next_step"],
      "properties": {
        "id": { "$ref": "#/$defs/gap_id" },
        "missing_info": { "$ref": "#/$defs/non_empty_string" },
        "why_unknown": { "$ref": "#/$defs/non_empty_string" },
        "impact_on_decision": { "$ref": "#/$defs/non_empty_string" },
        "mitigation_or_next_step": { "$ref": "#/$defs/non_empty_string" }
      }
    }
  }
}
